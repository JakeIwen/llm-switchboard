#!/usr/bin/env python3
"""The desk link's forced command (sshd, through the authorized_keys line
`desk link-authorize` writes; its argv is `DeskConfig.link_argv`, so moving
this file breaks the link). Run as `.venv/bin/python -I -B bin/desk-link`:
-I drops the script directory and PYTHONPATH, so the repo root is added here
from this file's resolved path. Imports stay stdlib + llm_switchboard.desk."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from llm_switchboard.desk.link_pump import main  # noqa: E402

sys.exit(main())
