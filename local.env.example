# Copy to local.env (gitignored) and fill in this install's names.
# KEY=value, no spaces: setup-mac.sh sources this file.

# SSH host alias the Mac uses to reach the Pi (host-agent --pi).
LLM_SWITCHBOARD_PI_SSH=pi
# The Mac's host name on the Pi's page and in its restricted key (host-agent --host-name).
LLM_SWITCHBOARD_MAC_NAME=mac

# For reference only; nothing reads these.
# The picker over Tailscale: MagicDNS name and address.
LLM_SWITCHBOARD_PICKER_URL=http://pi.example-tailnet.ts.net:8777
LLM_SWITCHBOARD_PICKER_IP_URL=http://100.64.0.1:8777
# Where the visual-guides user guide is served.
LLM_SWITCHBOARD_GUIDE_URL=http://pi.lan:8791/guides/llm-switchboard.html
