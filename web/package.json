{
  "name": "llm-switchboard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run check:css && npm run check:structure && npm run typecheck && vite build",
    "test": "vitest run && npm run test:react-app",
    "check:css": "node scripts/check-css.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "test:react-app": "node --test scripts/check-css.test.mjs scripts/check-structure.test.mjs scripts/react-app-tree.test.mjs",
    "gen:api": "(cd .. && .venv/bin/python -m llm_switchboard openapi) > openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts --default-non-nullable false"
  },
  "dependencies": {
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@tabler/icons-react": "3.49.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
